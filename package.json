{
  "name": "iceberg-tabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v1": "vite",
    "dev:v2": "vite --config vite.v2.config.ts",
    "build": "npm run build:v1",
    "build:v1": "tsc -b && vite build",
    "build:v2": "tsc -b && vite build --config vite.v2.config.ts",
    "preview:v1": "vite preview",
    "preview:v2": "vite preview --config vite.v2.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
