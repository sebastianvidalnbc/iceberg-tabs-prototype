{
  "name": "iceberg-tabs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:v1": "vite",
    "dev:v2": "vite --config vite.v2.config.ts",
    "build": "npm run build:v1",
    "build:v1": "tsc -b && vite build",
    "build:v2": "tsc -b && vite build --config vite.v2.config.ts",
    "preview:v1": "vite preview",
    "preview:v2": "vite preview --config vite.v2.config.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
